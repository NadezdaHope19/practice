@startuml
title Рекламная кампания (РК)
[*] --> Подготовка : создать РК
Подготовка --> В_поиске : запуск РК
В_поиске --> В_работе : поиск блоггера
В_поиске --> На_паузе
На_паузе --> В_поиске
На_паузе --> Отменена
state В_работе {
[*] -->  Создан : оффер
Создан --> Принят : блогер принимает оффер
Создан --> Отклонен : блогер отклоняет оффер
Создан --> Просрочен
Принят --> ОжидаетПодтверждения
Отклонен --> Создан
ОжидаетПодтверждения --> СоздатьСделку : селлер согласовал
ОжидаетПодтверждения --> Отменен : селлер не согласовал
}
state СоздатьСделку {
[*] --> Создать : сделка
Создать --> Отмена
Создать --> ПлатежСоздан : безопасная сделка
ПлатежСоздан --> СредстваЗабронированы
СредстваЗабронированы --> ВРаботе
Создать --> ВРаботе : обычная сделка
ВРаботе --> НаПроверке : выполнена
НаПроверке --> Завершена
ВРаботе --> Переговоры : не выполнена
Переговоры --> Отмена
Переговоры --> Спор
Спор --> Отмена
Спор --> ОжидаетОплаты
Завершена --> ОжидаетОплаты
Завершена --> Спор : нет оплаты
Завершена --> СредстваПереведены : безопасная сделка
}
state ОжидаетОплаты {
[*] --> Созданплатеж
Созданплатеж --> Оплачено
Созданплатеж --> ОшибкаОплаты
ОшибкаОплаты --> Созданплатеж
}
Оплачено --> [*]
СредстваПереведены --> [*]
@enduml
