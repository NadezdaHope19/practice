@startuml
title Рекламная кампания (РК)
[*] --> Подготовка : создать РК
Подготовка --> В_поиске
В_поиске --> В_работе : найти блогера
В_поиске --> На_паузе
На_паузе --> В_поиске
В_работе --> Отменена
state В_работе {
[*] -->  Создан : оффер
Создан --> Принят : блогер принимает оффер
Создан --> Отклонен : блогер отклоняет оффер
Создан --> Просрочен
Принят --> ОжидаетПодтверждения
Отклонен --> Создан
ОжидаетПодтверждения --> СоздатьСделку : селлер согласовал
ОжидаетПодтверждения --> Отменен : селлер не согласовал
}
state СоздатьСделку {
[*] --> Создать
Создать --> Отмена
Создать --> ЗаморозкаСредств : безопасная сделка
ЗаморозкаСредств --> ВРаботе
Создать --> ВРаботе : обычная сделка
ВРаботе --> НаПроверке : выполнена
НаПроверке --> Завершена
ВРаботе --> Переговоры : не выполнена
Переговоры --> Отмена
Переговоры --> Спор
Завершена --> ОжидаетОплаты
ОжидаетОплаты --> Оплачено
ОжидаетОплаты --> ОшибкаОплаты
ОшибкаОплаты --> ОжидаетОплаты
ОжидаетОплаты --> Спор : нет оплаты
}
Спор --> [*]
Оплачено --> [*]
@enduml
